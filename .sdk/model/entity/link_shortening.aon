# Entity: link_shortening

main: kit: entity: link_shortening: {

  alias: field: {}

  fields: [
    {
      format: "uri"
      name: "original_url"
      req: false
      short: "The original URL that was shortened"
      type: "`$STRING`"
    }
    {
      format: "uri"
      name: "short_link"
      req: false
      short: "The shortened URL"
      type: "`$STRING`"
    }
    {
      format: "uri"
      name: "url"
      req: true
      short: "The URL to be shortened"
      type: "`$STRING`"
    }
  ]

  name: "link_shortening"
  op: {
    create: {
      name: "create"
      points: [
        {
          method: "POST"
          orig: "/shorten/"
          segments: [
            {
              lit: "shorten"
            }
          ]
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
  }



}
